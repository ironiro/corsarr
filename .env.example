# Corsarr – configuration template for file-based setup.
#
# Not needed if you enter everything in the web interface (http://<ip>:8787/ → Configuration).
# Precedence when a value is set in several places: web interface > environment variable > this file.
# Usage: copy to ".env" in the start directory, or to /etc/corsarr.env (LXC), or load it via env_file
# in docker-compose.yml. Write values without quotes.

# --- Telegram ---------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Chat id of your group – always negative, larger groups start with -100
TELEGRAM_CHAT_ID=-1001234567890
# Optional: separate chat for Sonarr/Radarr download messages. Empty = the group above
NOTIFY_CHAT_ID=

# --- Claude API -------------------------------------------------------------------------
# API key from the Claude Console (set a monthly spend limit there)
ANTHROPIC_API_KEY=sk-ant-...
# Model. Empty = default
CLAUDE_MODEL=claude-haiku-5-5

# --- Jellyfin ---------------------------------------------------------------------------
# Address under which Corsarr reaches the server
JELLYFIN_URL=http://192.168.1.20:8096
# Dashboard → API Keys → +
JELLYFIN_API_KEY=...
# Name (or id) of the account you watch with together
JELLYFIN_USER=LivingRoom

# --- Jellyseerr -------------------------------------------------------------------------
JELLYSEERR_URL=http://192.168.1.21:5055
# Settings → General → API Key
JELLYSEERR_API_KEY=...

# --- Web server and webhooks ------------------------------------------------------------
# Address and port for the web interface and webhooks. Changes apply after restarting the program
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
# Shared secret for the Jellyfin, Sonarr and Radarr webhooks.
# Empty = generated randomly on first start and shown in the web interface
WEBHOOK_SECRET=
# Password for the web interface. Empty = no login (only run it on your home network)
ADMIN_PASSWORD=

# --- System -----------------------------------------------------------------------------
# Language of the web interface, and of the bot until someone writes to it (it then answers in the
# language it is addressed in): de or en
LANGUAGE=en
# Log verbosity: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Database, logs and web interface settings. Relative to the start directory or absolute.
# Already preset for LXC and Docker (/var/lib/corsarr and /data) – leave it out there
DATA_DIR=./data
