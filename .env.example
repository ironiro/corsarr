# Corsarr – configuration template for file-based setup.
#
# Not needed if you enter everything in the web interface (http://<ip>:8787/ → Configuration).
# Precedence when a value is set in several places: web interface > environment variable > this file.
# Usage: copy to ".env" in the start directory, or to /etc/corsarr.env (LXC), or load it via env_file
# in docker-compose.yml. Write values without quotes.

# --- Telegram ---------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Chat id of your group – always negative, larger groups start with -100
TELEGRAM_CHAT_ID=-1001234567890
# Optional: separate chat for Sonarr/Radarr download messages. Empty = the group above
NOTIFY_CHAT_ID=

# --- Language model ---------------------------------------------------------------------
# claude (recommended, tested) | openai | gemini | ollama | lmstudio (all untested)
LLM_PROVIDER=claude
# Claude: API key from the Claude Console (set a monthly spend limit there)
ANTHROPIC_API_KEY=sk-ant-...
# Model. Empty = default
CLAUDE_MODEL=claude-haiku-5-5
# Untested alternatives – only the fields of the selected provider are used:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OLLAMA_URL=http://192.168.1.30:11434
# OLLAMA_MODEL=
# LMSTUDIO_URL=http://192.168.1.30:1234
# LMSTUDIO_MODEL=

# --- Costs and budget (Claude only) -----------------------------------------------------
# Optional: estimated $ per month; when reached, the bot pauses until the next month (warning at 80 %).
# Empty = no budget
# MONTHLY_BUDGET_USD=
# Optional: private chat with the admin for budget warnings (write to the bot privately once, then pick
# yourself in the web interface). Empty = warnings go to the group
# ADMIN_CHAT_ID=

# --- Jellyfin ---------------------------------------------------------------------------
# Address under which Corsarr reaches the server
JELLYFIN_URL=http://192.168.1.20:8096
# Dashboard → API Keys → +
JELLYFIN_API_KEY=...
# Name (or id) of the account you watch with together
JELLYFIN_USER=LivingRoom

# --- Jellyseerr -------------------------------------------------------------------------
JELLYSEERR_URL=http://192.168.1.21:5055
# Settings → General → API Key
JELLYSEERR_API_KEY=...
# Optional: country whose streaming catalogues count, two-letter code (DE, US, …).
# Empty = derived from LANGUAGE (de → DE, otherwise US)
# STREAMING_REGION=
# Optional: streaming services you subscribe to, comma-separated TMDB provider ids (e.g. 8,337 for
# Netflix and Disney+); easier to pick in the web interface. Empty = feature off
# STREAMING_PROVIDERS=

# --- Web server and webhooks ------------------------------------------------------------
# Address and port for the web interface and webhooks. Changes apply after restarting the program
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
# Shared secret for the Jellyfin, Sonarr and Radarr webhooks.
# Empty = generated randomly on first start and shown in the web interface
WEBHOOK_SECRET=
# Optional: only for the active status check of Sonarr/Radarr (the setup assistant saves these with
# "Remember access"). Empty = Corsarr only notices their webhook messages
# SONARR_URL=http://192.168.1.22:8989
# SONARR_API_KEY=
# RADARR_URL=http://192.168.1.22:7878
# RADARR_API_KEY=
# Further host names the web interface and webhooks may be reached under, comma-separated
# (e.g. corsarr.example.org). IP addresses, localhost, names without a dot and .local/.lan/.home/.home.arpa/
# .internal/.test always work; other names get "403 unknown host" (protection against DNS rebinding)
# ALLOWED_HOSTS=
# Password for the web interface. Empty = no login (only run it on your home network)
ADMIN_PASSWORD=
# Release channel of the update check: stable (default) | beta (pre-releases too) | dev (every commit on main).
# Docker images follow the channel of their image tag instead
# UPDATE_CHANNEL=stable

# --- System -----------------------------------------------------------------------------
# Language of the web interface, and of the bot until someone writes to it (it then answers in the
# language it is addressed in): de or en
LANGUAGE=en
# Log verbosity: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Database, logs and web interface settings. Relative to the start directory or absolute.
# Already preset for LXC and Docker (/var/lib/corsarr and /data) – leave it out there
DATA_DIR=./data
